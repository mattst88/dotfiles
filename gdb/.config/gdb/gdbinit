set history save on
set history remove-duplicates unlimited
set history filename ~/.gdb_history
# "set disassembly-flavor" only exists for x86, so applying it unconditionally
# breaks gdb when the current architecture is anything else. Apply it lazily,
# once an objfile or executable tells us we are looking at x86.
python
def _set_intel_flavor(event=None):
    try:
        arch = gdb.selected_inferior().architecture().name()
    except gdb.error:
        return
    if arch.startswith("i386") or arch.startswith("i8086"):
        gdb.execute("set disassembly-flavor intel", to_string=True)

gdb.events.new_objfile.connect(_set_intel_flavor)
gdb.events.executable_changed.connect(_set_intel_flavor)
end
